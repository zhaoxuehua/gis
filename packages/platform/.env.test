# 测试环境
VITE_USER_NODE_ENV = test

# 公共基础路径
VITE_PUBLIC_PATH = /

# 是否启用 gzip 或 brotli 压缩打包，如果需要多个压缩规则，可以使用 “,” 分隔
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS = none

# 打包压缩后是否删除源文件
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 测试环境接口地址
VITE_API_URL = 

# 测试环境跨域代理，可配置多个   
# 原监控测试  http://10.233.29.227:8080   96环境http://192.168.14.96:6066(映射)
# release
VITE_PROXY = [["/api","http://10.233.51.16:8080"]]
# release2
# VITE_PROXY = [["/api","http://10.233.20.116:8080"]]
